# FinMate AI uses an OpenAI-*compatible* client, so it works with free-tier
# providers that need no credit card. Pick ONE of the two below (Groq is
# the default if you don't set FINMATE_LLM_PROVIDER).

# --- Option A: Groq (default) -----------------------------------------
# Free key, no credit card: https://console.groq.com -> API Keys
FINMATE_LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...

# --- Option B: Gemini ----------------------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
# Uncomment these two lines and comment out the Groq lines above instead.
# FINMATE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# --- Option C: any other OpenAI-compatible endpoint ---------------------
# FINMATE_LLM_PROVIDER=custom
# FINMATE_BASE_URL=https://your-provider.example.com/v1
# FINMATE_API_KEY=...

# Optional overrides (sensible defaults are picked per provider above):
# FINMATE_MODEL=llama-3.3-70b-versatile     # Groq default
# FINMATE_MODEL=gemini-2.5-flash            # Gemini default
FINMATE_DB_PATH=data/finmate.db
FINMATE_CHROMA_PATH=data/chroma_store
FINMATE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Supabase (use the anon key only in frontend browser variables; keep the
# service-role key in backend/.env or Render environment variables).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to "no_llm" to disable the optional query-rewrite step in hybrid
# retrieval (finmate/query_rewrite.py) -- keyword/vector/fusion/rerank all
# still run; this only skips the <=1 Groq/Gemini call per query used to
# expand the query text. Leave unset to allow it (still skips cleanly on
# its own if no key is configured). See README "RAG retrieval".
# FINMATE_RAG_MODE=no_llm

# Cross-encoder reranking (finmate/rag.py stage 6) is OFF by default --
# set to "true" to enable it. It's the one piece of the RAG pipeline
# heavy enough to matter on a memory-constrained host (e.g. Render's
# free tier, 512MB): loading the cross-encoder model on top of the
# embedder can OOM a small container. Retrieval works fully without it
# (metadata filter + keyword + vector search + fusion); rerank is an
# accuracy improvement on top, not a requirement. See README "RAG
# retrieval" and DEPLOYMENT.md's "Persistence, cost, and what's realistic".
# ENABLE_RERANKER=true
