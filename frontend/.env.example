# Frontend (Next.js) environment variables.
#
# Local dev: copy this file to frontend/.env.local (Next.js loads it
# automatically -- restart `npm run dev` after changing it). On Vercel,
# set this as a real Project Environment Variable in the dashboard
# instead -- .env files are never deployed. See ../DEPLOYMENT.md.

# URL of your FastAPI backend, no trailing slash. Must start with
# NEXT_PUBLIC_ -- Next.js only exposes env vars with that prefix to
# browser-side code (this app calls the backend directly from the
# browser, not through a Next.js server route), so anything read in
# lib/api.ts needs it or the value is undefined at runtime no matter
# what's set in Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000
