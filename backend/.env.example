# Backend (FastAPI) environment variables.
#
# Local dev: copy this file to backend/.env (uvicorn/python-dotenv picks
# it up automatically when you run from the backend/ directory -- see
# DEPLOYMENT.md's "Run locally" section). On Render, set these as real
# environment variables in the dashboard (or via render.yaml) instead --
# .env files are never deployed.

# --- LLM provider (same variables finmate/llm.py reads for app.py too) ---
# Pick ONE. Groq is the default if FINMATE_LLM_PROVIDER is unset.
FINMATE_LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# FINMATE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# --- CORS: comma-separated list of frontend origins allowed to call this API ---
# Local Next.js dev server default is already included if you leave this
# unset. For a deployed frontend, set this to your real Vercel URL(s) --
# see DEPLOYMENT.md. No wildcard "*" in production: this API reads/writes
# a specific user_id's financial data, so only known origins should be
# allowed to call it from a browser.
FINMATE_FRONTEND_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- Data paths ---
FINMATE_DB_PATH=../data/finmate.db
FINMATE_QDRANT_PATH=../data/qdrant_store

# --- Startup behavior ---
# Pre-load the embedder/cross-encoder/Qdrant client at process startup
# instead of on the first request (see finmate/rag.py:warm_up). Leave
# "true" unless your platform enforces a strict startup-time budget.
FINMATE_WARM_UP_ON_STARTUP=true

# --- Optional: disable the LLM query-rewrite step in RAG (see README "RAG retrieval") ---
# FINMATE_RAG_MODE=no_llm
